@using RecordShopFrontEnd.Models

<div class="box">
    @if(!string.IsNullOrEmpty(Record.ImageUrl))
    {
        <figure class="image is-square mb-3">
            <img src="@Record.ImageUrl" alt="@Record.Title" />
        </figure>
    }

    <h2 class="title is-5">@Record.Title</h2>
    <p><strong>Artist:</strong> @Record.Artist</p>
    <p><strong>Genre:</strong> @Record.Genre</p>
    <p><strong>Price:</strong> @Record.Price.ToString("C")</p>
</div>

@code {
    [Parameter]
    public Album Record { get; set; } = default!;
   
}
