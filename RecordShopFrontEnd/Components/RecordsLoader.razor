@using System.Net.Http.Json;
@using RecordShopFrontEnd.Models
@inject IConfiguration Configuration

@if(IsLoading)
{
        <div class="notification is-info">Loading records...</div>

}else if(!string.IsNullOrEmpty(ErrorMessage)){
    <div class="notification is-danger">Error loading records: @ErrorMessage</div>

    }else if (Records.Any()){
	<div><RecordsSummaryList Records="Records" /></div>

}else {
	<div class="notification is-warning">No Record Found.</div>
}

@code {

    public List<Album> Records { get; set; } = new List<Album>();
    public bool IsLoading { get; set; } = true;
    public string? ErrorMessage { get; set; } 


    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var httpClient = new HttpClient();
            string apiUrl = Configuration["ApiSettings:AlbumApiUrl"]!;
            Records = await httpClient.GetFromJsonAsync<List<Album>>(apiUrl) ?? new List<Album>();
        }
        catch (Exception ex)
        {
            ErrorMessage = "Sorry, we couldn't load this record. Please try again later.";
            Console.WriteLine($"Error loading record: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }
}

