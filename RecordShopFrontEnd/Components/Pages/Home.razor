@page "/"
@using RecordShopFrontEnd.Models
@using System.Net.Http.Json
@rendermode InteractiveServer



<PageTitle>Home</PageTitle>

<section class="section">
    <div class="container">
        <h1 class="title">Vinyl Vault</h1>
        <p class="subtitle">Browse records, discover artists, and build your collection.</p>

@if (IsLoading)
{
    <div class="notification is-info">Loading records...</div>

}
else if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="notification is-danger">Error loading records: @ErrorMessage</div>

}
else if (album != null)
{
    <div><RecordDetails Record="@album" /></div>

}
else
{
    <div class="notification is-warning">No Record Found.</div>
}
    </div>

</section>


@code {
   private Album? album;

    public bool IsLoading { get; set; } = true;
    public string? ErrorMessage { get; set; }

   

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var httpClient = new HttpClient();
            string apiUrl = "http://localhost:5000/api/album";
            var records = await httpClient.GetFromJsonAsync<List<Album>>(apiUrl);
            album = records?.FirstOrDefault();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

}