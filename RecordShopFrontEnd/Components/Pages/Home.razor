@page "/"

<PageTitle>Vinyl Vault</PageTitle>

<section class="hero is-success ">
    <div class="hero-body">
        <div class="container has-text-centered">
            <p class="title is-1">Vinyl Vault</p>
            <p class="subtitle is-4">
                Browse records, view album details, and update your catalogue.
            </p>

            <a class="button is-light is-medium" href="/records">
                Browse Records
            </a>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="columns is-variable is-5">
            <div class="column">
                <div class="box has-text-centered">
                    <h2 class="title is-4">Browse Records</h2>
                    <p>Explore the full vinyl catalogue with album covers, artists, genres, and prices.</p>
                </div>
            </div>

            <div class="column">
                <div class="box has-text-centered">
                    <h2 class="title is-4">View Stock</h2>
                    <p>Check how many copies are available before opening a record's detail page.</p>
                </div>
            </div>

            <div class="column">
                <div class="box has-text-centered">
                    <h2 class="title is-4">Update Details</h2>
                    <p>Edit album information including title, genre, price, stock, and cover image URL.</p>
                </div>
            </div>
        </div>
    </div>
</section>
<h2 class="title is-5 has-text-centered">How Vinyl Vault Works</h2>
<section class="section pt-0">
    <div class="container">
        <div class="box">
            <div class="columns has-text-centered">
                <div class="column">
                    <p class="heading">Step 1</p>
                    <p class="title is-5">Browse</p>
                    <p>Open the record catalogue and view every album currently stored in the shop.</p>
                </div>

                <div class="column">
                    <p class="heading">Step 2</p>
                    <p class="title is-5">Select</p>
                    <p>Choose a record card to view album details, stock, price, and cover art.</p>
                </div>

                <div class="column">
                    <p class="heading">Step 3</p>
                    <p class="title is-5">Update</p>
                    <p>Edit the record details and save the changes back to the database.</p>
                </div>
            </div>
        </div>
    </div>
</section>

