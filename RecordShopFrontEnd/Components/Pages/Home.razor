@page "/"

<PageTitle>Home</PageTitle>

<section class="hero is-success">
    <div class="hero-body">
        <div class="container">
            <p class="title is-1">Vinyl Vault</p>
            <p class="subtitle is-4">
                Browse records, discover artists, and build your collection.
            </p>

            <a class="button is-light is-medium" href="/records">
                Browse Records
            </a>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="columns">
            <div class="column">
                <div class="box">
                    <h2 class="title is-4">Browse Vinyl</h2>
                    <p>Explore albums by title, artist, genre, and release year.</p>
                </div>
            </div>

            <div class="column">
                <div class="box">
                    <h2 class="title is-4">Check Stock</h2>
                    <p>See what is currently available in the record shop inventory.</p>
                </div>
            </div>

            <div class="column">
                <div class="box">
                    <h2 class="title is-4">Manage Records</h2>
                    <p>Open a record page to view details and update album information.</p>
                </div>
            </div>
        </div>
    </div>
</section>
